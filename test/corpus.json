{
  "$comment": "Conformance corpus (spec §14.3). Each case pins the observable behaviour of one input, which carries its own organism scope: the canonical renderings, the derived scope, and — for invalid input — the phase, message and character offsets of the first diagnostic. A second implementation of the language should reproduce this file exactly.",
  "languageVersion": "0.2",
  "schema": "demo-1",
  "cases": [
    {
      "name": "core fields only, every organism in scope",
      "input": "host=='duck';collectionDate=ge=2024",
      "strict": "host=='duck';collectionDate=ge='2024'",
      "minimal": "host==duck;collectionDate=ge=2024",
      "readable": "host==duck;collectionDate>=2024",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "organism pinned in the string",
      "input": "organism==h5n1;nuc.HA.1234=='A'",
      "strict": "organism=='h5n1';nuc.HA.clade2344b.1234=='A'",
      "minimal": "organism==h5n1;nuc.HA.1234==A",
      "readable": "organism==h5n1;nuc.HA.1234==A",
      "scope": [
        "h5n1"
      ]
    },
    {
      "name": "conjunct order is irrelevant to scope",
      "input": "nuc.HA.1234=='A';organism==h5n1",
      "strict": "nuc.HA.clade2344b.1234=='A';organism=='h5n1'",
      "minimal": "nuc.HA.1234==A;organism==h5n1",
      "readable": "nuc.HA.1234==A;organism==h5n1",
      "scope": [
        "h5n1"
      ]
    },
    {
      "name": "a segment field across a taxon subtree",
      "input": "organism=descendantOf=influenzaA;length.HA=ge=1600",
      "strict": "organism=descendantOf='influenzaA';length.HA=ge='1600'",
      "minimal": "organism=descendantOf=influenzaA;length.HA=ge=1600",
      "readable": "organism=descendantOf=influenzaA;length.HA>=1600",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm"
      ]
    },
    {
      "name": "each OR branch scopes independently",
      "input": "organism==sars2;nuc.23403=='G',organism==h5n1;nuc.HA.1234=='A'",
      "strict": "organism=='sars2';nuc.wuhan1.23403=='G',organism=='h5n1';nuc.HA.clade2344b.1234=='A'",
      "minimal": "organism==sars2;nuc.23403==G,organism==h5n1;nuc.HA.1234==A",
      "readable": "organism==sars2;nuc.23403==G,organism==h5n1;nuc.HA.1234==A",
      "scope": [
        "h5n1",
        "sars2"
      ]
    },
    {
      "name": "an unscoped genome field is rejected, not guessed",
      "input": "nuc.23403=='G'",
      "error": {
        "phase": "resolve",
        "message": "'nuc' does not mean the same thing for h5n1 and sars2",
        "start": 0,
        "end": 3
      }
    },
    {
      "name": "a required slot is never inferred",
      "input": "organism==h5n1;nuc.1234=='A'",
      "error": {
        "phase": "resolve",
        "message": "'nuc' needs a seg for h5n1",
        "start": 15,
        "end": 23
      }
    },
    {
      "name": "a taxon group needs descendantOf",
      "input": "organism==influenzaA",
      "error": {
        "phase": "resolve",
        "message": "'influenzaA' is a group, not a single organism",
        "start": 10,
        "end": 20
      }
    },
    {
      "name": "comparator aliases are erased by canonicalisation",
      "input": "organism==h3n2;length.HA<=1700",
      "strict": "organism=='h3n2';length.HA=le='1700'",
      "minimal": "organism==h3n2;length.HA=le=1700",
      "readable": "organism==h3n2;length.HA<=1700",
      "scope": [
        "h3n2"
      ]
    },
    {
      "name": "whitespace is tolerated on input and erased",
      "input": "host == 'duck' ; country == 'France'",
      "strict": "host=='duck';country=='France'",
      "minimal": "host==duck;country==France",
      "readable": "host==duck;country==France",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "AND is associative across parentheses",
      "input": "host==duck;(country==France;version==1)",
      "strict": "host=='duck';country=='France';version=='1'",
      "minimal": "host==duck;country==France;version==1",
      "readable": "host==duck;country==France;version==1",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "an OR inside an AND keeps its parentheses",
      "input": "host==duck;(country==France,country==Germany)",
      "strict": "host=='duck';(country=='France',country=='Germany')",
      "minimal": "host==duck;(country==France,country==Germany)",
      "readable": "host==duck;(country==France,country==Germany)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "maybe wraps a subtree",
      "input": "maybe(collectionDate=ge=2021-03-15)",
      "strict": "maybe(collectionDate=ge='2021-03-15')",
      "minimal": "maybe(collectionDate=ge=2021-03-15)",
      "readable": "maybe(collectionDate>=2021-03-15)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "negation inside maybe is not the same as outside",
      "input": "maybe(!collectionDate=ge=2021-03-15)",
      "strict": "maybe(!collectionDate=ge='2021-03-15')",
      "minimal": "maybe(!collectionDate=ge=2021-03-15)",
      "readable": "maybe(!collectionDate>=2021-03-15)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "value lists",
      "input": "country=in=(Switzerland,France)",
      "strict": "country=in=('Switzerland','France')",
      "minimal": "country=in=(Switzerland,France)",
      "readable": "country=in=(Switzerland,France)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "hierarchy aliases resolve to canonical ids",
      "input": "organism==sars2;pangoLineage=descendantOf=BA",
      "strict": "organism=='sars2';pangoLineage=descendantOf='B.1.1.529'",
      "minimal": "organism==sars2;pangoLineage=descendantOf=B.1.1.529",
      "readable": "organism==sars2;pangoLineage=descendantOf=B.1.1.529",
      "scope": [
        "sars2"
      ]
    },
    {
      "name": "the reserved value ref stays unquoted",
      "input": "organism==sars2;nuc.23403!=ref",
      "strict": "organism=='sars2';nuc.wuhan1.23403!=ref",
      "minimal": "organism==sars2;nuc.23403!=ref",
      "readable": "organism==sars2;nuc.23403!=ref",
      "scope": [
        "sars2"
      ]
    },
    {
      "name": "insertions are their own family",
      "input": "organism==sars2;nuc_ins.22204=='GAGCCAGAA'",
      "strict": "organism=='sars2';nuc_ins.wuhan1.22204=='GAGCCAGAA'",
      "minimal": "organism==sars2;nuc_ins.22204==GAGCCAGAA",
      "readable": "organism==sars2;nuc_ins.22204==GAGCCAGAA",
      "scope": [
        "sars2"
      ]
    },
    {
      "name": "amino acid insertions mirror aa",
      "input": "organism==sars2;aa_ins.S.214=='EPE'",
      "strict": "organism=='sars2';aa_ins.S.wuhan1.214=='EPE'",
      "minimal": "organism==sars2;aa_ins.S.214==EPE",
      "readable": "organism==sars2;aa_ins.S.214==EPE",
      "scope": [
        "sars2"
      ]
    },
    {
      "name": "keyword slots are accepted",
      "input": "organism==h5n1;nuc(ref=clade23,seg=HA,pos=1234)=='A'",
      "strict": "organism=='h5n1';nuc.HA.clade23.1234=='A'",
      "minimal": "organism==h5n1;nuc.HA.clade23.1234==A",
      "readable": "organism==h5n1;nuc.HA.clade23.1234==A",
      "scope": [
        "h5n1"
      ]
    },
    {
      "name": "isNull selects on missing data",
      "input": "collectionDate=isNull=true",
      "strict": "collectionDate=isNull='true'",
      "minimal": "collectionDate=isNull=true",
      "readable": "collectionDate=isNull=true",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "quoted values keep characters the bare form cannot carry",
      "input": "submitter=='Müller, A.; Lee, B.'",
      "strict": "submitter=='Müller, A.; Lee, B.'",
      "minimal": "submitter=='Müller, A.; Lee, B.'",
      "readable": "submitter=='Müller, A.; Lee, B.'",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "braces are rejected with the reason",
      "input": "organism==h5n1;length{seg=HA}=ge=1600",
      "error": {
        "phase": "lex",
        "message": "'{' is not allowed here",
        "start": 21,
        "end": 22
      }
    },
    {
      "name": "an unterminated quote is reported at the quote",
      "input": "country=='France",
      "error": {
        "phase": "lex",
        "message": "unterminated quoted value",
        "start": 9,
        "end": 16
      }
    },
    {
      "name": "a missing comparator is a parse error",
      "input": "country",
      "error": {
        "phase": "parse",
        "message": "expected a comparator, found end of query",
        "start": 7,
        "end": 7
      }
    },
    {
      "name": "a closed date range",
      "input": "collectionDate=inRange=(2021-01,2021-03)",
      "strict": "collectionDate=inRange=('2021-01','2021-03')",
      "minimal": "collectionDate=inRange=(2021-01,2021-03)",
      "readable": "collectionDate=inRange=(2021-01,2021-03)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "a range of one partial date is equality on that month (§9.2)",
      "input": "collectionDate=inRange=(2021-03,2021-03)",
      "strict": "collectionDate=inRange=('2021-03','2021-03')",
      "minimal": "collectionDate=inRange=(2021-03,2021-03)",
      "readable": "collectionDate=inRange=(2021-03,2021-03)",
      "scope": [
        "h5n1",
        "h3n2",
        "h1n1pdm",
        "sars2",
        "rsvA",
        "rsvB"
      ]
    },
    {
      "name": "a length range on a segment",
      "input": "organism==h3n2;length.HA=inRange=(1600,1700)",
      "strict": "organism=='h3n2';length.HA=inRange=('1600','1700')",
      "minimal": "organism==h3n2;length.HA=inRange=(1600,1700)",
      "readable": "organism==h3n2;length.HA=inRange=(1600,1700)",
      "scope": [
        "h3n2"
      ]
    },
    {
      "name": "a range needs exactly two bounds",
      "input": "organism==h3n2;length.HA=inRange=1600",
      "error": {
        "phase": "resolve",
        "message": "=inRange= takes exactly 2 values",
        "start": 15,
        "end": 37
      }
    },
    {
      "name": "bounds in the wrong order are an error, not an empty result",
      "input": "organism==h3n2;length.HA=inRange=(1700,1600)",
      "error": {
        "phase": "resolve",
        "message": "the lower bound is above the upper bound, so the range is empty",
        "start": 15,
        "end": 43
      }
    },
    {
      "name": "an operator that does not apply to the type",
      "input": "country=ge=France",
      "error": {
        "phase": "resolve",
        "message": "=ge= does not apply to enum field 'country'",
        "start": 7,
        "end": 11
      }
    },
    {
      "name": "a typo in an enum value suggests the intended one",
      "input": "country==Frnace",
      "error": {
        "phase": "resolve",
        "message": "'Frnace' is not a known country",
        "start": 9,
        "end": 15
      }
    },
    {
      "name": "organism filters that cannot hold together",
      "input": "organism==sars2;organism==h5n1",
      "error": {
        "phase": "resolve",
        "message": "these organism filters cannot be satisfied together",
        "start": 0,
        "end": 30
      }
    }
  ]
}
